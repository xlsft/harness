# harness core server. Copy to .env (Nitro loads it in `pnpm dev`) or export in your shell.

# Master secret (>= 32 chars). Derives the Better Auth secret and the AES-256-GCM key for provider API keys.
# If unset, one is generated into $HARNESS_DATA_DIR/secret (fine for dev, set it explicitly in production).
# Changing it makes stored provider keys unreadable and signs everyone out.
HARNESS_SECRET=

# Public base URL of the server (used for verification_uri and Better Auth). Default: http://localhost:$PORT
HARNESS_PUBLIC_URL=http://localhost:3000
PORT=3000

# Data directory (generated secret, embedded PGlite database). Default: ./.data
HARNESS_DATA_DIR=./.data

# Postgres. Unset: embedded PGlite (Postgres in WASM, in-process) persisted to $HARNESS_DATA_DIR/pglite,
# nothing to install. Set it to use a real server, over TCP or a unix socket:
# DATABASE_URL=postgres://harness:secret@localhost:5432/harness
# DATABASE_URL=postgres:///harness?host=/run/postgresql

# Admin bootstrap: created (or promoted to admin) on startup if set.
HARNESS_ADMIN_EMAIL=admin@example.com
HARNESS_ADMIN_PASSWORD=change-me-please

# Allow public email/password sign-up (default false: an admin creates users).
# HARNESS_ALLOW_SIGNUP=false

# Prompt files directory. Default: ./prompts
# HARNESS_PROMPTS_DIR=./prompts

# Optional h2c (HTTP/2 cleartext) listener serving the Connect services with plain gRPC as well.
# HARNESS_GRPC_PORT=3001

# Reject harness-client user agents older than this version (FAILED_PRECONDITION / UNSUPPORTED_CLIENT).
# HARNESS_MIN_CLIENT_VERSION=0.1.0

# Gateway tuning
# HARNESS_UPSTREAM_MAX_RETRIES=8
# HARNESS_UPSTREAM_RETRY_BASE_MS=500
# HARNESS_PING_INTERVAL_MS=10000
