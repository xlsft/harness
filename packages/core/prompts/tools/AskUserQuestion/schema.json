{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "type": "object",
  "properties": {
    "questions": {
      "type": "array",
      "minItems": 1,
      "maxItems": 4,
      "description": "Questions to ask the user (1-4)",
      "items": {
        "type": "object",
        "properties": {
          "question": { "type": "string", "description": "The complete question to ask, ending with a question mark" },
          "header": { "type": "string", "maxLength": 12, "description": "Very short label shown as a chip (max 12 characters)" },
          "options": {
            "type": "array",
            "minItems": 2,
            "maxItems": 4,
            "description": "The available choices (2-4). The user can also answer in free form",
            "items": {
              "type": "object",
              "properties": {
                "label": { "type": "string", "description": "Short display text of the option (1-5 words)" },
                "description": { "type": "string", "description": "What choosing this option means or implies" }
              },
              "required": ["label", "description"],
              "additionalProperties": false
            }
          },
          "multiSelect": { "type": "boolean", "description": "Allow the user to choose more than one option" }
        },
        "required": ["question", "header", "options", "multiSelect"],
        "additionalProperties": false
      }
    }
  },
  "required": ["questions"],
  "additionalProperties": false
}
