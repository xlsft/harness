{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "type": "object",
  "properties": {
    "level": {
      "type": "string",
      "enum": [
        "all",
        "error",
        "warning",
        "info",
        "log",
        "debug"
      ],
      "description": "Lowest level to show (default all)"
    },
    "pattern": {
      "type": "string",
      "description": "Keep only entries matching this regular expression or text"
    },
    "limit": {
      "type": "integer",
      "minimum": 1,
      "maximum": 200,
      "description": "How many of the latest matching entries to show (default 50)"
    },
    "clear": {
      "type": "boolean",
      "description": "Empty the log after reading it"
    }
  },
  "additionalProperties": false
}
