{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "type": "object",
  "properties": {
    "file_path": {
      "type": "string",
      "description": "Absolute path of the file to modify"
    },
    "edits": {
      "type": "array",
      "minItems": 1,
      "description": "The replacements, applied in order",
      "items": {
        "type": "object",
        "properties": {
          "old_string": {
            "type": "string",
            "description": "Exact text to replace; must be unique unless replace_all is true"
          },
          "new_string": {
            "type": "string",
            "description": "Replacement text (must differ from old_string)"
          },
          "replace_all": {
            "type": "boolean",
            "default": false,
            "description": "Replace every occurrence"
          }
        },
        "required": [
          "old_string",
          "new_string"
        ],
        "additionalProperties": false
      }
    },
    "description": {
      "type": "string",
      "description": "A short label of what this call works on or looks for, shown to the user as its row: a noun phrase of 2 to 6 words, no leading verb"
    }
  },
  "required": [
    "file_path",
    "edits",
    "description"
  ],
  "additionalProperties": false
}
