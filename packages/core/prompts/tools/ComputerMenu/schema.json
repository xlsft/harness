{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "type": "object",
  "properties": {
    "app": {
      "type": "string",
      "description": "The app, by name or id."
    },
    "path": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "minItems": 2,
      "description": "Menu titles, from the bar to the item."
    }
  },
  "required": [
    "app",
    "path"
  ],
  "additionalProperties": false
}
