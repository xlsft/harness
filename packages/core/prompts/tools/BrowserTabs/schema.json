{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "type": "object",
  "properties": {
    "action": {
      "type": "string",
      "enum": [
        "list",
        "new",
        "switch",
        "close"
      ],
      "description": "What to do (default list)"
    },
    "tab_id": {
      "type": "string",
      "description": "Tab to switch to or close, e.g. t2"
    },
    "url": {
      "type": "string",
      "description": "For new: the address to open (default a blank tab)"
    }
  },
  "additionalProperties": false
}
