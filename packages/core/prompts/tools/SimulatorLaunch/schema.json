{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "type": "object",
  "properties": {
    "device": {
      "type": "string",
      "description": "The device's UDID or name. Optional when one device is booted."
    },
    "bundle_id": {
      "type": "string",
      "description": "The app's bundle identifier."
    },
    "args": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "description": "Launch arguments for the app."
    },
    "restart": {
      "type": "boolean",
      "description": "Stop a running instance first. Default true."
    }
  },
  "required": [
    "bundle_id"
  ],
  "additionalProperties": false
}
