{
  "name": "harness-core",
  "private": true,
  "type": "module",
  "version": "0.0.0",
  "description": "harness server: auth, LLM gateway, prompt registry",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "dev": "nitro dev",
    "build": "nitro build",
    "start": "node .output/server/index.mjs",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "db:generate": "drizzle-kit generate && node scripts/embed-migrations.ts",
    "admin:create": "node scripts/create-admin.ts",
    "gen": "cd ../.. && buf generate"
  },
  "dependencies": {
    "@bufbuild/protobuf": "^2.16.0",
    "@connectrpc/connect": "^2.3.0",
    "@connectrpc/connect-node": "^2.3.0",
    "@electric-sql/pglite": "^0.5.14",
    "@modelcontextprotocol/sdk": "1.32.2",
    "@node-saml/node-saml": "5.2.0",
    "@opentelemetry/api": "1.10.0",
    "@opentelemetry/context-async-hooks": "3.0.0",
    "@opentelemetry/core": "3.0.0",
    "@opentelemetry/exporter-metrics-otlp-http": "0.300.0",
    "@opentelemetry/exporter-trace-otlp-http": "0.300.0",
    "@opentelemetry/resources": "3.0.0",
    "@opentelemetry/sdk-metrics": "3.0.0",
    "@opentelemetry/sdk-trace": "3.0.0",
    "better-auth": "1.7.15",
    "drizzle-orm": "0.45.4",
    "h3": "^2.0.8",
    "jose": "6.2.15",
    "ldapts": "9.2.0",
    "nitro": "3.0.261029-rc",
    "pg": "^8.23.1",
    "undici": "^8.12.3",
    "uqr": "0.1.3",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@bufbuild/protoc-gen-es": "^2.16.0",
    "@types/node": "^24.19.2",
    "@types/pg": "^8.23.1",
    "drizzle-kit": "0.31.11",
    "typescript": "6.0.3",
    "vitest": "^4.1.12",
    "xml-crypto": "6.4.0"
  },
  "packageManager": "pnpm@11.8.0"
}
