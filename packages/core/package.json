{
  "name": "harness-core",
  "private": true,
  "type": "module",
  "version": "0.0.0",
  "description": "harness server: auth, LLM gateway, prompt registry",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "dev": "nitro dev",
    "build": "nitro build",
    "start": "node .output/server/index.mjs",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "db:generate": "drizzle-kit generate && node scripts/embed-migrations.ts",
    "admin:create": "node scripts/create-admin.ts",
    "gen": "cd ../.. && buf generate"
  },
  "dependencies": {
    "@bufbuild/protobuf": "^2.16.0",
    "@connectrpc/connect": "^2.3.0",
    "@connectrpc/connect-node": "^2.3.0",
    "@libsql/client": "^0.18.0",
    "better-auth": "1.7.15",
    "drizzle-orm": "0.45.4",
    "h3": "^2.0.8",
    "nitro": "3.0.261029-rc",
    "undici": "^8.12.3"
  },
  "devDependencies": {
    "@bufbuild/protoc-gen-es": "^2.16.0",
    "@types/node": "^24.19.2",
    "drizzle-kit": "0.31.11",
    "typescript": "6.0.3",
    "vitest": "^4.1.12"
  }
}
