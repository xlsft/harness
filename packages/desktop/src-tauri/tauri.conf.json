{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "xlsft`s harness",
  "version": "0.1.0",
  "identifier": "dev.xlsft.harness",
  "build": {
    "beforeDevCommand": "bash scripts/ui-dev.sh",
    "devUrl": "http://localhost:3210",
    "beforeBuildCommand": "pnpm --dir ../ui generate",
    "frontendDist": "../../ui/.output/public"
  },
  "app": {
    "windows": [
      {
        "title": "xlsft`s harness",
        "width": 1440,
        "height": 900,
        "minWidth": 900,
        "minHeight": 560,
        "backgroundColor": "#000000",
        "titleBarStyle": "Overlay",
        "hiddenTitle": true,
        "trafficLightPosition": {
          "x": 16,
          "y": 23
        }
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "externalBin": [
      "binaries/harness-client"
    ],
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ]
  }
}
