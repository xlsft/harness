{
  "$schema": "../gen/schemas/desktop-schema.json",
  "identifier": "default",
  "description": "The main window: the shell's commands, native folder picker, reveal and open files.",
  "windows": ["main"],
  "permissions": [
    "core:default",
    "dialog:allow-open",
    "opener:allow-open-url",
    "opener:allow-reveal-item-in-dir",
    { "identifier": "opener:allow-open-path", "allow": [{ "path": "**" }] }
  ]
}
