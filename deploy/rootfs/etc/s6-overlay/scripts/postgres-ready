#!/command/with-contenv sh
# One-shot between postgres and core: waits until Postgres accepts connections, then makes sure the
# `harness` role and database exist (idempotent, so it also repairs a half-initialized cluster).
set -eu
LOG_TAG=postgres-ready
. /etc/s6-overlay/scripts/lib.sh

internal_postgres || exit 0

i=0
until pg_isready -q -h "$PG_SOCKET_DIR" -U postgres -d postgres; do
  i=$((i + 1))
  if [ "$i" -ge 240 ]; then
    log "ERROR: Postgres did not become ready within 120 s"
    exit 1
  fi
  sleep 0.5
done

psql_admin() {
  s6-setuidgid postgres psql -X -q -v ON_ERROR_STOP=1 -h "$PG_SOCKET_DIR" -U postgres -d postgres -tA "$@"
}

if [ "$(psql_admin -c "SELECT 1 FROM pg_roles WHERE rolname = 'harness'")" != "1" ]; then
  log "creating role harness"
  psql_admin -c "CREATE ROLE harness LOGIN"
fi
if [ "$(psql_admin -c "SELECT 1 FROM pg_database WHERE datname = 'harness'")" != "1" ]; then
  log "creating database harness"
  psql_admin -c "CREATE DATABASE harness OWNER harness"
fi
log "Postgres is ready"
